{
  "name": "@adonisjs-community/girouette",
  "description": "An AdonisJS package allowing decorators-based routing.",
  "version": "1.0.1",
  "engines": {
    "node": ">=20.6.0"
  },
  "type": "module",
  "files": [
    "build/src",
    "build/providers",
    "build/services",
    "build/stubs",
    "build/index.d.ts",
    "build/index.js",
    "build/configure.d.ts",
    "build/configure.js"
  ],
  "exports": {
    ".": {
      "import": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./girouette_provider": {
      "import": "./build/providers/girouette_provider.js",
      "types": "./build/providers/girouette_provider.d.ts"
    },
    "./hooks": {
      "import": "./build/src/hooks/index_controllers.js",
      "types": "./build/src/hooks/index_controllers.d.ts"
    },
    "./services/main": "./build/services/main.js"
  },
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "scripts": {
    "clean": "del-cli build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny correctness --ignore-pattern build --ignore-pattern playground --ignore-pattern docs --allow no-empty-pattern",
    "format": "prettier --write .",
    "quick:test": "node --import=./tsnode.esm.js --enable-source-maps bin/test.ts",
    "pretest": "npm run lint",
    "copy:templates": "copyfiles --up 1 \"stubs/**/*.stub\" build/stubs",
    "test": "c8 --include=src --include=providers --reporter=json-summary npm run quick:test && istanbul-badges-readme",
    "prebuild": "npm run lint && npm run clean",
    "build": "pnpm clean && tsc && pnpm copy:templates",
    "dev": "tsc --watch",
    "release": "release-it",
    "version": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@adonisjs/assembler": "8.4.0",
    "@adonisjs/core": "7.3.5",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^3.0.0",
    "@japa/runner": "^3.1.4",
    "@swc/core": "^1.15.47",
    "@types/node": "^20.19.43",
    "c8": "^10.1.3",
    "copyfiles": "^2.4.1",
    "del-cli": "^5.1.0",
    "istanbul-badges-readme": "^1.9.0",
    "np": "^10.3.0",
    "oxlint": "^1.77.0",
    "prettier": "^3.9.6",
    "release-it": "^19.2.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "deepmerge": "^4.3.1",
    "reflect-metadata": "^0.2.2"
  },
  "peerDependencies": {
    "@adonisjs/core": "^7.0.0-next.17"
  },
  "author": "Alexis Bouchez <alexis@softwarecitadel.com>",
  "license": "MIT",
  "keywords": [
    "AdonisJS",
    "decorators",
    "routing"
  ],
  "prettier": "@adonisjs/prettier-config",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "repository": "github:adonisjs-community/girouette",
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "tests/**"
    ]
  }
}
